{
  "name": "bravest-browser",
  "version": "1.0.0",
  "description": "Bravest - Brave Browser fork with native 3x/4x YouTube speed playback and Brave Shields ad-blocking",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "pack": "electron-builder --win portable"
  },
  "keywords": [
    "brave",
    "browser",
    "adblocker",
    "youtube",
    "playback-speed"
  ],
  "author": "Bravest Project",
  "license": "MPL-2.0",
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.2",
    "cross-fetch": "^4.1.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.bravest.browser",
    "productName": "Bravest",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "engine/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Bravest.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Bravest-Setup.exe"
    }
  }
}
